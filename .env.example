# Copia a .env para desarrollo local. En producción: /etc/ayunora/env (chmod 600).
HOST=127.0.0.1
PORT=3100
DATABASE_PATH=./data/ayunora.db
# Genera las claves con: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://ayunora.es
# Temporal (M0): protege la suscripción y el push de prueba hasta que haya login (M1).
SETUP_TOKEN=
